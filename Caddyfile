{
	admin off
	http_port 8080
	https_port 8443
	default_sni {$SITE_HOST}
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

https://{$SITE_HOST} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:8080
	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "Product Lens 서비스를 준비하고 있습니다." 503
	}
}
